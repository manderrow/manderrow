node_modules
dist

# Shared by the branches with the Tauri app (src-tauri) and the Qt app (src-qt), so that switching
# between them leaves no build output untracked.

# Generated by Cargo
# will have compiled files and executables
/src-tauri/target/
/src-qt/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/src-tauri/gen/schemas

# Generated by cxx-qt-build for the QML language server, with a machine-specific path
/src-qt/.qmlls.ini
